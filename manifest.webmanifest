{
  "name": "ChordFlow",
  "short_name": "ChordFlow",
  "description": "Interactive Web Audio SPA for previewing chords across Piano, Guitar, Ukulele, Guitalele, Violin, Bass, and Harmonica, building progressions, and exploring music theory.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0d17",
  "theme_color": "#0b0d17",
  "orientation": "any",
  "categories": [
    "music",
    "education",
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Instrument Tuner",
      "short_name": "Tuner",
      "description": "Open the chromatic instrument tuner",
      "url": "./index.html?modal=tuner",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Music Theory & Circle of Fifths",
      "short_name": "Theory",
      "description": "Explore the Circle of Fifths and modal theory",
      "url": "./index.html?modal=theory",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Progression Styles",
      "short_name": "Styles",
      "description": "Browse chord progression formulas and styles",
      "url": "./index.html?modal=styles",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}